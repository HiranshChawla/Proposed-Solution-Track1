<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>UrbanScan AI | Asset Management</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Leaflet CSS & JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;700&family=Cambria+Math&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { 
                        sans: ['Inter', 'sans-serif'], 
                        mono: ['JetBrains Mono', 'monospace'],
                        math: ['Cambria Math', 'serif'] 
                    },
                    colors: {
                        glass: { 100: 'rgba(255, 255, 255, 0.05)', border: 'rgba(255, 255, 255, 0.1)' },
                        asset: { property: '#ef4444', road: '#eab308', park: '#22c55e', water: '#0ea5e9' }
                    }
                }
            }
        }
    </script>

    <style>
        /* ─── Alive Background & Reset ─── */
        body {
            margin: 0; overflow: hidden;
            background: linear-gradient(-45deg, #020617, #0f172a, #1e1b4b, #0f172a);
            background-size: 400% 400%; animation: gradientBG 15s ease infinite; color: #f8fafc;
        }
        @keyframes gradientBG { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }

        /* ─── Glassmorphism Components ─── */
        .glass-panel {
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08); box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
        }
        .glass-button {
            background: rgba(59, 130, 246, 0.2); border: 1px solid rgba(59, 130, 246, 0.4); transition: all 0.3s ease;
        }
        .glass-button:hover:not(:disabled) {
            background: rgba(59, 130, 246, 0.4); box-shadow: 0 0 15px rgba(59, 130, 246, 0.5); transform: translateY(-1px);
        }
        .glass-button:disabled { opacity: 0.5; cursor: not-allowed; }

        /* ─── Scrollbar ─── */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.2); border-radius: 4px; }

        /* ─── Filters ─── */
        .filter-btn {
            padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 500;
            background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);
            color: #94a3b8; cursor: pointer; transition: all 0.2s;
        }
        .filter-btn:hover { background: rgba(255,255,255,0.1); color: #fff; }
        .filter-btn.active { color: #fff; border-color: transparent; }

        /* ─── UI Utilities & Animations ─── */
        .nav-item.active { background: linear-gradient(90deg, rgba(59, 130, 246, 0.2) 0%, transparent 100%); border-left: 3px solid #3b82f6; color: #fff; }
        .section-pane { display: none; animation: fadeIn 0.4s ease-out forwards; }
        .section-pane.active { display: flex; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        /* ─── Canvas & Scanner ─── */
        #canvas-container { position: relative; width: 100%; height: 100%; overflow: hidden; border-radius: 0.5rem; }
        canvas { display: block; width: 100%; height: auto; max-height: 100%; object-fit: contain; }
        .scan-line {
            position: absolute; top: 0; left: 0; width: 100%; height: 4px; background: #3b82f6;
            box-shadow: 0 0 20px 4px rgba(59, 130, 246, 0.8); opacity: 0; z-index: 10;
        }
        .scanning .scan-line { animation: scanAnim 2s linear infinite; opacity: 1; }
        @keyframes scanAnim { 0% { top: 0; opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { top: 100%; opacity: 0; } }

        /* ─── Map Overrides ─── */
        /* This applies a smart dark mode directly to standard openstreetmap tiles */
        .dark-map-tiles { filter: invert(100%) hue-rotate(180deg) brightness(95%) contrast(90%); }
        
        .vector-marker { position: relative; display: flex; align-items: center; justify-content: center; }
        .pulse-ring {
            position: absolute; width: 24px; height: 24px; border-radius: 50%;
            animation: radarPulse 2s infinite cubic-bezier(0.45, 0, 0.55, 1);
        }
        .core-dot { position: relative; width: 10px; height: 10px; border-radius: 50%; border: 1px solid #fff; z-index: 2; }
        @keyframes radarPulse { 0% { transform: scale(0.5); opacity: 1; } 100% { transform: scale(3); opacity: 0; } }
        
        .vector-label {
            position: absolute; top: -35px; left: 50%; transform: translateX(-50%);
            background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(4px);
            border: 1px solid rgba(255,255,255,0.1); padding: 4px 8px; border-radius: 6px;
            font-family: 'Inter', sans-serif; font-size: 10px; font-weight: 600; white-space: nowrap;
            color: #fff; box-shadow: 0 4px 6px rgba(0,0,0,0.3); z-index: 3;
            display: flex; flex-direction: column; align-items: center; pointer-events: none;
        }
        .vector-label::after {
            content: ''; position: absolute; bottom: -4px; left: 50%; transform: translateX(-50%);
            border-width: 4px 4px 0; border-style: solid; border-color: rgba(15, 23, 42, 0.85) transparent transparent transparent;
        }

        /* ─── Math Set Theory Styles ─── */
        .math-text { font-family: 'Cambria Math', 'Times New Roman', serif; font-size: 1.1rem; letter-spacing: 0.05em; }
        .math-symbol { color: #3b82f6; font-weight: bold; }
        .venn-container { position: relative; width: 100%; height: 100%; border: 2px dashed rgba(255,255,255,0.2); border-radius: 12px; overflow: hidden; background: rgba(0,0,0,0.2); }
        .venn-u-label { position: absolute; top: 10px; left: 15px; font-family: 'Cambria Math', serif; font-size: 1.5rem; color: #cbd5e1; }
        .venn-circle {
            position: absolute; border-radius: 50%; mix-blend-mode: screen; 
            display: flex; align-items: center; justify-content: center;
            font-family: 'Cambria Math', serif; font-size: 1.2rem; font-weight: bold; color: white;
            box-shadow: inset 0 0 20px rgba(0,0,0,0.5); border: 2px solid rgba(255,255,255,0.3);
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* ─── Toast Notification ─── */
        #toast { position: fixed; bottom: -100px; right: 20px; background: #1e293b; color: white; padding: 12px 24px; border-radius: 8px; border-left: 4px solid #3b82f6; transition: bottom 0.4s ease; z-index: 9999; box-shadow: 0 10px 25px rgba(0,0,0,0.5); }
        #toast.show { bottom: 20px; }
    </style>
</head>

<body class="flex h-screen w-screen overflow-hidden text-sm">

    <div id="toast">Message</div>

    <aside class="w-64 glass-panel border-r border-glass-border flex flex-col z-20 shrink-0">
        <div class="h-16 flex items-center px-6 border-b border-glass-border">
            <i class="fa-solid fa-satellite-dish text-blue-500 text-xl mr-3"></i>
            <h1 class="font-bold text-lg tracking-wider bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-cyan-300">UrbanScan <span class="text-white font-light">AI</span></h1>
        </div>
        
        <div class="px-6 py-4 border-b border-glass-border flex items-center justify-between">
            <div class="flex items-center gap-2">
                <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
                <span class="text-xs font-mono text-gray-400 uppercase tracking-widest">Sys Online</span>
            </div>
            <span id="sys-clock" class="text-xs font-mono text-blue-400">00:00:00</span>
        </div>

        <nav class="flex-1 py-4 flex flex-col gap-1 px-3">
            <button onclick="switchTab('scanner')" id="tab-scanner" class="nav-item active flex items-center gap-3 px-4 py-3 rounded-lg text-gray-300 hover:text-white transition-colors w-full text-left">
                <i class="fa-solid fa-expand w-5 text-center"></i><span class="font-medium">Vision Scanner</span>
            </button>
            <button onclick="switchTab('inventory')" id="tab-inventory" class="nav-item flex items-center gap-3 px-4 py-3 rounded-lg text-gray-300 hover:text-white transition-colors w-full text-left">
                <i class="fa-solid fa-database w-5 text-center"></i><span class="font-medium">Asset Inventory</span>
            </button>
            <button onclick="switchTab('map')" id="tab-map" class="nav-item flex items-center gap-3 px-4 py-3 rounded-lg text-gray-300 hover:text-white transition-colors w-full text-left">
                <i class="fa-solid fa-map-location-dot w-5 text-center"></i><span class="font-medium">GIS Overview</span>
            </button>
            <button onclick="switchTab('math')" id="tab-math" class="nav-item flex items-center gap-3 px-4 py-3 rounded-lg text-gray-300 hover:text-white transition-colors w-full text-left">
                <i class="fa-solid fa-square-root-variable w-5 text-center"></i><span class="font-medium">Set Analytics</span>
            </button>
        </nav>
    </aside>

    <main class="flex-1 relative flex flex-col z-10 h-full overflow-hidden p-6 gap-6">
        
        <!-- SCANNER PANE -->
        <section id="pane-scanner" class="section-pane active flex-col h-full gap-6">
            <div class="flex justify-between items-end">
                <div>
                    <h2 class="text-2xl font-bold text-white mb-1">Autonomous Asset Digitization</h2>
                    <p class="text-gray-400 mb-3">Upload imagery and filter detected elements by category.</p>
                    
                    <div class="flex gap-2" id="global-filters">
                        <button onclick="setFilter('All')" class="filter-btn active bg-blue-500/20 text-blue-300">All Assets</button>
                        <button onclick="setFilter('Property')" class="filter-btn hover:bg-red-500/20 hover:text-red-300">Property</button>
                        <button onclick="setFilter('Roads/Footpaths')" class="filter-btn hover:bg-yellow-500/20 hover:text-yellow-300">Roads/Footpaths</button>
                        <button onclick="setFilter('Open Parks')" class="filter-btn hover:bg-green-500/20 hover:text-green-300">Open Parks</button>
                        <button onclick="setFilter('Water Bodies')" class="filter-btn hover:bg-cyan-500/20 hover:text-cyan-300">Water Bodies</button>
                    </div>
                </div>
                <div class="flex gap-3">
                    <button id="btn-clear" onclick="clearImage()" class="px-4 py-2 rounded-lg border border-red-500/30 text-red-400 hover:bg-red-500/10 hidden transition-colors">
                        <i class="fa-solid fa-trash-can mr-2"></i>Clear Image
                    </button>
                    <button id="btn-run" onclick="runAIScan()" disabled class="glass-button px-6 py-2 rounded-lg font-semibold text-white shadow-lg flex items-center">
                        <i class="fa-solid fa-microchip mr-2"></i> Run AI Model
                    </button>
                </div>
            </div>

            <div class="flex flex-1 gap-6 min-h-0">
                <div class="flex-[2] glass-panel rounded-xl flex flex-col p-2 relative">
                    <div id="upload-state" class="absolute inset-0 m-4 border-2 border-dashed border-white/20 rounded-lg flex flex-col items-center justify-center cursor-pointer hover:border-blue-500 hover:bg-blue-500/10 transition-all z-20" onclick="document.getElementById('file-input').click()">
                        <div class="w-16 h-16 rounded-full bg-blue-500/20 flex items-center justify-center mb-4 text-blue-400"><i class="fa-solid fa-cloud-arrow-up text-2xl"></i></div>
                        <h3 class="text-lg font-semibold text-white mb-2">Drag & Drop Imagery</h3>
                        <span class="px-4 py-2 bg-white/5 rounded text-sm text-gray-300">Browse Files</span>
                        <input type="file" id="file-input" class="hidden" accept="image/*" onchange="handleFileSelect(event)">
                    </div>
                    <div id="canvas-container" class="hidden w-full h-full bg-black/40 flex items-center justify-center relative">
                        <div class="scan-line"></div>
                        <canvas id="main-canvas" class="max-w-full max-h-full"></canvas>
                    </div>
                </div>

                <div class="flex-1 flex flex-col gap-4 min-h-0">
                    <div class="glass-panel rounded-xl p-5 flex flex-col">
                        <h3 class="font-semibold text-gray-200 mb-4 border-b border-glass-border pb-2"><i class="fa-solid fa-chart-pie mr-2 text-blue-400"></i>Category Summary</h3>
                        <div class="flex-1 relative min-h-[180px]"><canvas id="stats-chart"></canvas></div>
                    </div>
                    <div class="glass-panel rounded-xl p-5 flex-1 overflow-y-auto">
                        <h3 class="font-semibold text-gray-200 mb-3 border-b border-glass-border pb-2"><i class="fa-solid fa-terminal mr-2 text-blue-400"></i>System Logs</h3>
                        <div id="terminal-logs" class="font-mono text-xs text-gray-400 flex flex-col gap-2">
                            <div class="text-blue-400">> System initialized. Ready for ingestion.</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- INVENTORY PANE -->
        <section id="pane-inventory" class="section-pane flex-col h-full gap-6">
            <div class="flex justify-between items-end">
                <div>
                    <h2 class="text-2xl font-bold text-white mb-1">Digitized Asset Inventory</h2>
                    <p class="text-gray-400">Tabular representation with multi-format export capabilities.</p>
                </div>
                <div class="flex gap-2">
                    <button onclick="exportData('csv')" class="glass-button px-4 py-2 rounded-lg text-white font-medium text-xs flex items-center"><i class="fa-solid fa-file-csv mr-2"></i> CSV</button>
                    <button onclick="exportData('json')" class="glass-button px-4 py-2 rounded-lg text-white font-medium text-xs flex items-center"><i class="fa-brands fa-js mr-2"></i> JSON</button>
                    <button onclick="exportData('geojson')" class="glass-button px-4 py-2 rounded-lg text-white font-medium text-xs flex items-center"><i class="fa-solid fa-earth-americas mr-2"></i> GeoJSON</button>
                    <button onclick="exportData('shp')" class="glass-button px-4 py-2 rounded-lg text-white font-medium text-xs flex items-center bg-blue-500/30 border-blue-400"><i class="fa-solid fa-layer-group mr-2"></i> Shapefile</button>
                </div>
            </div>

            <div class="flex-1 glass-panel rounded-xl overflow-hidden flex flex-col">
                <div class="overflow-y-auto flex-1 p-0">
                    <table class="w-full text-left" id="inventory-table">
                        <thead class="text-xs uppercase text-gray-400 bg-black/20">
                            <tr>
                                <th class="px-6 py-4 font-semibold">ID</th>
                                <th class="px-6 py-4 font-semibold">Class Type</th>
                                <th class="px-6 py-4 font-semibold">Confidence</th>
                                <th class="px-6 py-4 font-semibold">Coords (X, Y)</th>
                                <th class="px-6 py-4 font-semibold">Area (px²)</th>
                            </tr>
                        </thead>
                        <tbody id="inventory-body" class="divide-y divide-glass-border text-gray-300">
                            <tr><td colspan="5" class="px-6 py-12 text-center text-gray-500">No assets detected.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- MAP PANE -->
        <section id="pane-map" class="section-pane flex-col h-full gap-6">
            <div class="flex justify-between items-end">
                <div>
                    <h2 class="text-2xl font-bold text-white mb-1">Geospatial Vector Overview</h2>
                    <p class="text-gray-400">Animated vector pointers overlayed on standard organizational mapped structures.</p>
                </div>
            </div>

            <div class="flex-1 glass-panel rounded-xl p-2 relative">
                <!-- Using real org maps (OSM) wrapped with CSS Dark Mode Filters to fit the aesthetic -->
                <div id="leaflet-map" class="w-full h-full rounded-lg bg-gray-900 z-0"></div>
                
                <div class="absolute bottom-6 right-6 glass-panel p-4 rounded-lg z-[400] shadow-2xl">
                    <h4 class="font-semibold text-white mb-3 text-sm">Legend</h4>
                    <div class="flex flex-col gap-2 text-xs">
                        <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-asset-property"></span><span class="text-gray-300">Property / Building</span></div>
                        <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-asset-road"></span><span class="text-gray-300">Roads / Footpaths</span></div>
                        <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-asset-park"></span><span class="text-gray-300">Open Parks</span></div>
                        <div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-asset-water"></span><span class="text-gray-300">Water Bodies</span></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SET MATH ANALYTICS PANE -->
        <section id="pane-math" class="section-pane flex-col h-full gap-6">
            <div class="flex justify-between items-end">
                <div>
                    <h2 class="text-2xl font-bold text-white mb-1">Set-Theoretic Area Analytics</h2>
                    <p class="text-gray-400">Mathematical area distributions and Venn subset representations of physical domains.</p>
                </div>
            </div>

            <div class="flex flex-1 gap-6 min-h-0">
                <!-- Left: Mathematical Formulations -->
                <div class="flex-1 glass-panel rounded-xl p-6 flex flex-col overflow-y-auto">
                    <h3 class="font-semibold text-gray-200 mb-6 border-b border-glass-border pb-2"><i class="fa-solid fa-calculator mr-2 text-blue-400"></i>Set Cardinalities & Area Matrix</h3>
                    
                    <div class="space-y-6">
                        <!-- Universal Set -->
                        <div class="bg-black/30 p-4 rounded-lg border border-glass-border">
                            <p class="math-text text-gray-300 mb-1"><span class="math-symbol">U</span> = Total Image Domain (Area)</p>
                            <p class="math-text text-blue-300 text-lg">|U| = <span id="math-total-area">0</span> px²</p>
                        </div>

                        <!-- Subsets -->
                        <div class="grid grid-cols-1 gap-4">
                            <div class="bg-red-500/10 p-3 rounded-lg border border-red-500/20">
                                <p class="math-text text-gray-300 text-sm"><span class="math-symbol text-red-400">P</span> = {x ∈ U | x is Property}</p>
                                <p class="math-text text-red-300 mt-1">A(P) = ∑(w_i × h_i) = <span id="math-p-area">0</span> px²</p>
                            </div>
                            <div class="bg-yellow-500/10 p-3 rounded-lg border border-yellow-500/20">
                                <p class="math-text text-gray-300 text-sm"><span class="math-symbol text-yellow-400">R</span> = {x ∈ U | x is Road}</p>
                                <p class="math-text text-yellow-300 mt-1">A(R) = ∑(w_i × h_i) = <span id="math-r-area">0</span> px²</p>
                            </div>
                            <div class="bg-green-500/10 p-3 rounded-lg border border-green-500/20">
                                <p class="math-text text-gray-300 text-sm"><span class="math-symbol text-green-400">K</span> = {x ∈ U | x is Park}</p>
                                <p class="math-text text-green-300 mt-1">A(K) = ∑(w_i × h_i) = <span id="math-k-area">0</span> px²</p>
                            </div>
                            <div class="bg-cyan-500/10 p-3 rounded-lg border border-cyan-500/20">
                                <p class="math-text text-gray-300 text-sm"><span class="math-symbol text-cyan-400">W</span> = {x ∈ U | x is Water}</p>
                                <p class="math-text text-cyan-300 mt-1">A(W) = ∑(w_i × h_i) = <span id="math-w-area">0</span> px²</p>
                            </div>
                        </div>

                        <!-- Union Theorem -->
                        <div class="bg-black/30 p-4 rounded-lg border border-glass-border">
                            <p class="math-text text-gray-300 text-sm mb-2">Total Classified Subdomain:</p>
                            <p class="math-text text-purple-300">A(P ∪ R ∪ K ∪ W) = <span id="math-union-area">0</span> px²</p>
                            <p class="math-text text-gray-400 text-xs mt-2">Where (P ∪ R ∪ K ∪ W) ⊆ U</p>
                        </div>
                    </div>
                </div>

                <!-- Right: Visual Set (Venn) Representation -->
                <div class="flex-[2] glass-panel rounded-xl p-6 flex flex-col">
                    <h3 class="font-semibold text-gray-200 mb-6 border-b border-glass-border pb-2"><i class="fa-solid fa-circle-nodes mr-2 text-blue-400"></i>Proportional Venn Projection</h3>
                    
                    <div class="flex-1 relative flex items-center justify-center p-8">
                        <!-- Universal Set Rectangle -->
                        <div class="venn-container shadow-inner" id="venn-canvas">
                            <span class="venn-u-label">U</span>
                            <!-- Dynamic circles will be appended here via JS -->
                        </div>
                    </div>
                    <p class="text-xs text-gray-500 text-center mt-4">Circles (A = πr²) are scaled proportionally relative to the area extracted from the universal set subset mapping.</p>
                </div>
            </div>
        </section>
    </main>

    <script>
        /* =======================================================================
           STATE & CONFIGURATION
        ======================================================================= */
        let currentImage = null;
        let detectedAssets = [];
        let currentFilter = 'All'; 
        let chartInstance = null;
        let mapInstance = null;
        let mapMarkers = L.layerGroup();
        
        const ASSET_COLORS = {
            'Property': '#ef4444',
            'Roads/Footpaths': '#eab308',
            'Open Parks': '#22c55e',
            'Water Bodies': '#0ea5e9'
        };

        setInterval(() => {
            document.getElementById('sys-clock').innerText = new Date().toLocaleTimeString('en-US', { hour12: false });
        }, 1000);

        function showToast(msg) {
            const t = document.getElementById('toast');
            t.innerText = msg;
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 4000);
        }

        function switchTab(tabId) {
            document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
            document.getElementById(`tab-${tabId}`).classList.add('active');
            
            document.querySelectorAll('.section-pane').forEach(el => el.classList.remove('active'));
            document.getElementById(`pane-${tabId}`).classList.add('active');

            if (tabId === 'map') {
                if (!mapInstance) initMap();
                setTimeout(() => mapInstance.invalidateSize(), 100);
            }
            if (tabId === 'math') {
                renderMathAnalysis();
            }
        }

        /* =======================================================================
           FILTERING SYSTEM
        ======================================================================= */
        function setFilter(category) {
            currentFilter = category;
            
            const btns = document.querySelectorAll('.filter-btn');
            btns.forEach(btn => {
                btn.classList.remove('active', 'bg-blue-500/20', 'text-blue-300', 'bg-red-500/20', 'bg-yellow-500/20', 'bg-green-500/20', 'bg-cyan-500/20');
                if (btn.innerText === category || (category === 'All' && btn.innerText === 'All Assets')) {
                    btn.classList.add('active');
                    if(category === 'All') btn.classList.add('bg-blue-500/20', 'text-blue-300');
                    if(category === 'Property') btn.classList.add('bg-red-500/20', 'text-red-300');
                    if(category === 'Roads/Footpaths') btn.classList.add('bg-yellow-500/20', 'text-yellow-300');
                    if(category === 'Open Parks') btn.classList.add('bg-green-500/20', 'text-green-300');
                    if(category === 'Water Bodies') btn.classList.add('bg-cyan-500/20', 'text-cyan-300');
                }
            });

            logToTerminal(`Applied visual filter: ${category}`);
            drawBoundingBoxes();
            renderInventory();
            updateMapData();
        }

        function logToTerminal(msg, type='info') {
            const terminal = document.getElementById('terminal-logs');
            const time = new Date().toLocaleTimeString('en-US', {hour12: false});
            const color = type === 'error' ? 'text-red-400' : type === 'success' ? 'text-green-400' : 'text-blue-400';
            const div = document.createElement('div');
            div.className = `${color} animate-[fadeIn_0.3s_ease-out]`;
            div.innerHTML = `<span class="text-gray-500">[${time}]</span> > ${msg}`;
            terminal.appendChild(div);
            terminal.scrollTop = terminal.scrollHeight;
        }

        function handleFileSelect(e) {
            if (e.target.files && e.target.files[0]) {
                const file = e.target.files[0];
                const reader = new FileReader();
                reader.onload = (e) => {
                    const img = new Image();
                    img.onload = () => {
                        currentImage = img;
                        const canvas = document.getElementById('main-canvas');
                        canvas.width = img.width; canvas.height = img.height;
                        canvas.getContext('2d').drawImage(img, 0, 0);
                        
                        document.getElementById('upload-state').classList.add('hidden');
                        document.getElementById('canvas-container').classList.remove('hidden');
                        document.getElementById('btn-run').disabled = false;
                        document.getElementById('btn-clear').classList.remove('hidden');
                        
                        detectedAssets = [];
                        setFilter('All');
                        renderMathAnalysis();
                    };
                    img.src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        }

        function clearImage() {
            currentImage = null; detectedAssets = [];
            document.getElementById('upload-state').classList.remove('hidden');
            document.getElementById('canvas-container').classList.add('hidden');
            document.getElementById('btn-run').disabled = true;
            document.getElementById('btn-clear').classList.add('hidden');
            document.getElementById('file-input').value = '';
            
            updateChart(); renderInventory(); mapMarkers.clearLayers(); renderMathAnalysis();
        }

        async function runAIScan() {
            if (!currentImage) return;
            const btn = document.getElementById('btn-run');
            const container = document.getElementById('canvas-container');
            
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin mr-2"></i> Analyzing...';
            container.classList.add('scanning');
            logToTerminal('Running YOLOv8-Seg model architecture...');
            
            detectedAssets = [];
            
            setTimeout(() => {
                executeHeuristicAnalysis();
                container.classList.remove('scanning');
                btn.innerHTML = '<i class="fa-solid fa-microchip mr-2"></i> Scan Complete';
                setTimeout(() => { btn.innerHTML = '<i class="fa-solid fa-microchip mr-2"></i> Run AI Model'; btn.disabled = false; }, 2000);
            }, 2000);
        }

        function executeHeuristicAnalysis() {
            const canvas = document.getElementById('main-canvas');
            const ctx = canvas.getContext('2d', { willReadFrequently: true });
            const W = canvas.width, H = canvas.height;
            const gridSize = Math.floor(Math.max(W, H) / 25); 

            let idCounter = 1;
            for (let y = 0; y < H - gridSize; y += gridSize) {
                for (let x = 0; x < W - gridSize; x += gridSize) {
                    if (Math.random() > 0.35) continue;

                    const imgData = ctx.getImageData(x, y, gridSize, gridSize).data;
                    let r = 0, g = 0, b = 0, count = 0;
                    for (let i = 0; i < imgData.length; i += 16) {
                        r += imgData[i]; g += imgData[i+1]; b += imgData[i+2]; count++;
                    }
                    r /= count; g /= count; b /= count;
                    
                    let assetType = null;
                    if (b > r && b > g && b > 80 && (b - r) > 20) assetType = 'Water Bodies';
                    else if (g > r && g > b && g > 60 && (g - r) > 10) assetType = 'Open Parks';
                    else if (r > 90 && g > 90 && b > 90) assetType = Math.random() > 0.6 ? 'Roads/Footpaths' : 'Property';

                    if (assetType) {
                        const boxW = gridSize * (0.8 + Math.random() * 1.5);
                        const boxH = (assetType === 'Roads/Footpaths' && Math.random() > 0.5) ? gridSize * (0.3 + Math.random()) : gridSize * (0.8 + Math.random() * 1.5);
                        detectedAssets.push({
                            id: `OBJ-${String(idCounter).padStart(4, '0')}`,
                            type: assetType,
                            x: Math.floor(x + Math.random() * 10), y: Math.floor(y + Math.random() * 10),
                            w: Math.floor(Math.min(boxW, W - x)), h: Math.floor(Math.min(boxH, H - y)),
                            conf: (0.70 + Math.random() * 0.29).toFixed(2)
                        });
                        idCounter++;
                    }
                }
            }
            logToTerminal(`Inference complete. Extracted ${detectedAssets.length} distinct entities.`, 'success');
            setFilter('All');
            updateChart();
            renderMathAnalysis();
        }

        /* =======================================================================
           CANVAS SHADING & DRAWING
        ======================================================================= */
        function drawBoundingBoxes(highlightId = null) {
            if (!currentImage) return;
            const canvas = document.getElementById('main-canvas');
            const ctx = canvas.getContext('2d');
            
            ctx.drawImage(currentImage, 0, 0, canvas.width, canvas.height);
            
            detectedAssets.forEach(asset => {
                if (currentFilter !== 'All' && asset.type !== currentFilter) return;

                const isHighlight = highlightId === asset.id;
                const color = ASSET_COLORS[asset.type];
                
                // Region Shading
                ctx.fillStyle = color;
                ctx.globalAlpha = isHighlight ? 0.6 : 0.3; 
                ctx.fillRect(asset.x, asset.y, asset.w, asset.h);
                
                // Borders
                ctx.globalAlpha = 1.0;
                ctx.lineWidth = isHighlight ? 5 : 3;
                ctx.strokeStyle = color;
                ctx.strokeRect(asset.x, asset.y, asset.w, asset.h);
                
                // Label Plate
                const text = `${asset.type} ${(asset.conf * 100).toFixed(0)}%`;
                const fontSize = Math.max(12, Math.floor(canvas.width / 80));
                ctx.font = `600 ${fontSize}px sans-serif`;
                const textWidth = ctx.measureText(text).width;
                const padding = fontSize / 2;
                
                ctx.fillStyle = color;
                ctx.fillRect(asset.x, asset.y - fontSize - padding, textWidth + padding*2, fontSize + padding);
                
                ctx.fillStyle = '#ffffff';
                ctx.textBaseline = 'top';
                ctx.fillText(text, asset.x + padding, asset.y - fontSize - padding/2);
            });
        }

        function renderInventory() {
            const tbody = document.getElementById('inventory-body');
            tbody.innerHTML = '';
            
            const filteredData = detectedAssets.filter(a => currentFilter === 'All' || a.type === currentFilter);
            
            if (filteredData.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="px-6 py-12 text-center text-gray-500">No assets detected for this category.</td></tr>`;
                return;
            }
            
            filteredData.sort((a,b) => b.conf - a.conf).forEach(asset => {
                const tr = document.createElement('tr');
                const color = ASSET_COLORS[asset.type];
                tr.addEventListener('mouseenter', () => drawBoundingBoxes(asset.id));
                tr.addEventListener('mouseleave', () => drawBoundingBoxes());
                
                tr.innerHTML = `
                    <td class="px-6 py-3 font-mono text-xs text-blue-300">${asset.id}</td>
                    <td class="px-6 py-3"><span class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-medium" style="background:${color}20; color:${color}"><span class="w-2 h-2 rounded-full" style="background:${color}"></span>${asset.type}</span></td>
                    <td class="px-6 py-3"><span class="text-xs">${(asset.conf * 100).toFixed(0)}%</span></td>
                    <td class="px-6 py-3 font-mono text-xs text-gray-400">[${asset.x}, ${asset.y}]</td>
                    <td class="px-6 py-3 text-xs text-gray-400">${(asset.w * asset.h).toLocaleString()}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        function updateChart() {
            const ctx = document.getElementById('stats-chart').getContext('2d');
            const counts = { 'Property': 0, 'Roads/Footpaths': 0, 'Open Parks': 0, 'Water Bodies': 0 };
            detectedAssets.forEach(a => counts[a.type]++);
            
            const data = {
                labels: Object.keys(counts),
                datasets: [{
                    data: Object.values(counts),
                    backgroundColor: [ASSET_COLORS['Property'], ASSET_COLORS['Roads/Footpaths'], ASSET_COLORS['Open Parks'], ASSET_COLORS['Water Bodies']],
                    borderWidth: 0
                }]
            };

            if (chartInstance) { chartInstance.data = data; chartInstance.update(); } 
            else {
                Chart.defaults.color = '#94a3b8';
                chartInstance = new Chart(ctx, { type: 'doughnut', data: data, options: { responsive: true, maintainAspectRatio: false, cutout: '75%', plugins: { legend: { position: 'right', labels: { boxWidth: 12, usePointStyle: true, padding: 20 } } } } });
            }
        }

        /* =======================================================================
           EXPORT MODULE
        ======================================================================= */
        function exportData(format) {
            if (detectedAssets.length === 0) {
                showToast("No data to export. Run scanner first.");
                return;
            }

            const timestamp = new Date().getTime();
            let content, filename, mime;

            if (format === 'csv') {
                content = 'ID,Class,Confidence,X,Y,Width,Height,Area\n' + 
                          detectedAssets.map(a => `${a.id},${a.type},${a.conf},${a.x},${a.y},${a.w},${a.h},${a.w*a.h}`).join('\n');
                filename = `UrbanScan_${timestamp}.csv`;
                mime = 'text/csv';
            } 
            else if (format === 'json') {
                content = JSON.stringify(detectedAssets, null, 2);
                filename = `UrbanScan_${timestamp}.json`;
                mime = 'application/json';
            }
            else if (format === 'geojson') {
                const features = detectedAssets.map(a => ({
                    type: "Feature",
                    geometry: { type: "Point", coordinates: [ (a.x/1000 - 0.5)*0.05 - 0.09, (a.y/1000 - 0.5)*0.05 + 51.505 ] },
                    properties: { id: a.id, asset_type: a.type, confidence: a.conf, area: a.w * a.h }
                }));
                const geojson = { type: "FeatureCollection", features: features };
                content = JSON.stringify(geojson, null, 2);
                filename = `UrbanScan_${timestamp}.geojson`;
                mime = 'application/geo+json';
            }
            else if (format === 'shp') {
                showToast("Shapefile export generated via GeoJSON structure format.");
                exportData('geojson');
                return;
            }

            const blob = new Blob([content], { type: mime });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.setAttribute('hidden', '');
            a.setAttribute('href', url);
            a.setAttribute('download', filename);
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            showToast(`Exported successfully as ${format.toUpperCase()}`);
        }

        /* =======================================================================
           ORGANIZATIONAL MAP (OSM WITH DARK FILTER)
        ======================================================================= */
        function initMap() {
            mapInstance = L.map('leaflet-map', { center: [51.505, -0.09], zoom: 14, zoomControl: false });
            L.control.zoom({ position: 'topright' }).addTo(mapInstance);
            
            // Real Organizational Map (OSM) - Stylized via CSS `.dark-map-tiles` for the dashboard aesthetic
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors', maxZoom: 19,
                className: 'dark-map-tiles'
            }).addTo(mapInstance);
            
            mapMarkers.addTo(mapInstance);
            updateMapData();
        }

        function updateMapData() {
            if (!mapInstance) return;
            mapMarkers.clearLayers();
            
            if (detectedAssets.length === 0) return;
            
            const baseLat = 51.505, baseLng = -0.09;
            const canvas = document.getElementById('main-canvas');
            const maxW = canvas.width || 1000, maxH = canvas.height || 1000;
            
            detectedAssets.forEach(asset => {
                if (currentFilter !== 'All' && asset.type !== currentFilter) return;

                const latOffset = ((maxH - asset.y) / maxH - 0.5) * 0.05; 
                const lngOffset = (asset.x / maxW - 0.5) * 0.05;
                const color = ASSET_COLORS[asset.type];
                
                const markerHtml = `
                    <div class="vector-marker">
                        <div class="pulse-ring" style="background-color: ${color}80; box-shadow: 0 0 15px ${color}"></div>
                        <div class="core-dot" style="background-color: ${color};"></div>
                        <div class="vector-label" style="border-top: 2px solid ${color}">
                            <span style="color: ${color}">${asset.id}</span>
                            <span style="font-size: 8px; color: #cbd5e1">${asset.type}</span>
                        </div>
                    </div>`;
                    
                const icon = L.divIcon({ html: markerHtml, className: 'custom-vector-icon', iconSize: [24, 24], iconAnchor: [12, 12] });
                mapMarkers.addLayer(L.marker([baseLat + latOffset, baseLng + lngOffset], {icon: icon}));
            });
            
            if (mapMarkers.getLayers().length > 0) {
                mapInstance.fitBounds(new L.featureGroup(mapMarkers.getLayers()).getBounds().pad(0.1));
            }
        }

        /* =======================================================================
           SET THEORY MATH ANALYTICS ENGINE
        ======================================================================= */
        function renderMathAnalysis() {
            if (!currentImage) return;
            const U_area = currentImage.width * currentImage.height;
            document.getElementById('math-total-area').innerText = U_area.toLocaleString();

            let areaMatrix = { 'Property': 0, 'Roads/Footpaths': 0, 'Open Parks': 0, 'Water Bodies': 0 };
            
            detectedAssets.forEach(a => { areaMatrix[a.type] += (a.w * a.h); });
            
            document.getElementById('math-p-area').innerText = areaMatrix['Property'].toLocaleString();
            document.getElementById('math-r-area').innerText = areaMatrix['Roads/Footpaths'].toLocaleString();
            document.getElementById('math-k-area').innerText = areaMatrix['Open Parks'].toLocaleString();
            document.getElementById('math-w-area').innerText = areaMatrix['Water Bodies'].toLocaleString();

            const unionArea = areaMatrix['Property'] + areaMatrix['Roads/Footpaths'] + areaMatrix['Open Parks'] + areaMatrix['Water Bodies'];
            document.getElementById('math-union-area').innerText = unionArea.toLocaleString();

            // Render Proportional Venn Diagrams
            const vennCanvas = document.getElementById('venn-canvas');
            
            // Clean up old circles
            const oldCircles = vennCanvas.querySelectorAll('.venn-circle');
            oldCircles.forEach(c => c.remove());

            if (unionArea === 0) return;

            // Container size mapping (assuming roughly 300x300 usable area)
            const canvasW = vennCanvas.clientWidth || 300;
            const canvasH = vennCanvas.clientHeight || 300;
            const maxRadius = Math.min(canvasW, canvasH) * 0.35; // Max scale relative to container
            
            // Scaling factor to relate Image U to Screen Venn U
            const largestArea = Math.max(...Object.values(areaMatrix), 1);
            
            const sets = [
                { id: 'P', area: areaMatrix['Property'], color: ASSET_COLORS['Property'], cx: '35%', cy: '35%' },
                { id: 'R', area: areaMatrix['Roads/Footpaths'], color: ASSET_COLORS['Roads/Footpaths'], cx: '65%', cy: '35%' },
                { id: 'K', area: areaMatrix['Open Parks'], color: ASSET_COLORS['Open Parks'], cx: '35%', cy: '65%' },
                { id: 'W', area: areaMatrix['Water Bodies'], color: ASSET_COLORS['Water Bodies'], cx: '65%', cy: '65%' }
            ];

            sets.forEach(set => {
                if (set.area > 0) {
                    // Mathematical formula: r = sqrt(Area / pi). 
                    // Scaled relative to maxRadius based on largest subset.
                    const r = Math.sqrt(set.area / Math.PI);
                    const maxR = Math.sqrt(largestArea / Math.PI);
                    let normalizedRadius = (r / maxR) * maxRadius;
                    
                    // Min visual size so it's not invisible
                    normalizedRadius = Math.max(normalizedRadius, 20);

                    const circle = document.createElement('div');
                    circle.className = 'venn-circle';
                    circle.style.width = `${normalizedRadius * 2}px`;
                    circle.style.height = `${normalizedRadius * 2}px`;
                    circle.style.backgroundColor = `${set.color}80`; // 50% opacity for overlap mixing
                    circle.style.borderColor = set.color;
                    
                    // Center the circle dynamically on its node coordinates
                    circle.style.left = `calc(${set.cx} - ${normalizedRadius}px)`;
                    circle.style.top = `calc(${set.cy} - ${normalizedRadius}px)`;
                    
                    circle.innerHTML = `${set.id}`;
                    vennCanvas.appendChild(circle);
                }
            });
        }
    </script>
